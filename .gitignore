# =============================================================
# AetherLearn 仓库根 .gitignore
# 忽略构建产物、依赖、上传文件、IDE 配置与本地敏感配置。
# =============================================================

# ---- 构建产物 ----
target/
dist/
build/
out/

# ---- 依赖（前端）----
node_modules/

# ---- 上传文件（运行时生成）----
uploads/

# ---- IDE ----
.idea/
.vscode/
*.iml

# ---- 本地敏感配置（含 AI 密钥，禁止提交 GitHub）----
application-local.yml
api-key.txt

# ---- 系统/临时 ----
.DS_Store
Thumbs.db
*.log
