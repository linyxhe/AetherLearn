# ========== 服务基础 ==========
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
WORKERS=1
# 内部服务鉴权；生产环境请替换为随机密钥，并通过环境变量注入，不要提交真实密钥。
SERVICE_API_KEY=change-this-internal-secret

# ========== Milvus ==========
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB=aetherlearn
# 新集合保存当前切片；旧集合 knowledge_chunks 仅保留作历史兼容。
COLLECTION_NAME=knowledge_chunks_v2
LEGACY_COLLECTION_NAME=knowledge_chunks
COLLECTION_COMPATIBILITY=auto

# ========== Embedding (BGE-M3) ==========
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=8192
# Docker Compose 默认使用 CPU；有 NVIDIA GPU 时可覆盖为 cuda。
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false

# ========== Reranker (BGE-Reranker-v2-m3) ==========
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=16
# Docker Compose 默认使用 CPU；有 NVIDIA GPU 时可覆盖为 cuda。
RERANKER_DEVICE=cpu
RERANKER_USE_ONNX=true
RERANKER_ONNX_PATH=models/reranker.onnx
# 启动后后台预热模型（首次提问更快）；设为 false 可让服务启动更轻量。
WARMUP_ON_STARTUP=true
# 模型加载失败后的冷却秒数；冷却期内跳过精排，避免拖垮检索请求。
RERANKER_RETRY_INTERVAL=60
# CPU 上 Cross-Encoder 较慢：只精排 RRF 头部候选，0 表示不限制（20→约17s，12→约10s）。
RERANKER_MAX_CANDIDATES=12

# ========== LLM (OpenAI 兼容接口) ==========
# 请将 LLM_API_KEY 设置为真实密钥；为空时 AI 服务会返回降级状态。
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nex-agi/nex-n2.5-mini:free
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ========== MySQL（供 backfill_milvus.py 读取历史切片） ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aetherlearn
DB_USER=root
# 请通过环境变量注入真实密码，不要提交到仓库。
DB_PASSWORD=

# ========== Java 后端回调 ==========
JAVA_CALLBACK_URL=http://127.0.0.1:8080

# ========== 检索默认参数 ==========
DEFAULT_TOP_K=30
DEFAULT_RERANK_TOP_K=10
RRF_K=60