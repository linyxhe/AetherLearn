# =============================================================
# AetherLearn 仓库根 .gitignore
# 忽略构建产物、依赖、上传文件、IDE 配置与本地敏感配置。
# =============================================================

# ---- 构建产物 ----
target/
dist/
build/
out/

# ---- 依赖（前端）----
node_modules/

# ---- 依赖（Python）----
.venv/
**/.venv/
.venv*/
**/.venv*/

# ---- 模型缓存（体积大，运行时下载）----
aetherlearn-ai-service/models/
**/huggingface/
*.onnx
*.safetensors

# ---- 上传文件（运行时生成）----
uploads/

# ---- IDE ----
.idea/
.vscode/
*.iml

# ---- 本地敏感配置（含 AI 密钥，禁止提交 GitHub）----
application-local.yml
.env
.env.local
.env.development
.env.production
aetherlearn-ai-service/.env
api-key.txt

# ---- Python 运行时缓存 ----
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc
.pytest_cache/
**/.pytest_cache/

# ---- 本地开发配置（含数据库明文口令，禁止提交）----
# 说明：application.yml（默认 dev profile）需要它才能启动，但密码必须外置后再入库，
# 详见开发日志的"未决"：把 password 改成 ${DB_PASSWORD:} 并让启动脚本从 .env 导出。
AetherLearn_backend/src/main/resources/application-dev.yml

# ---- 运行期日志（stderr 可能含请求上下文，不进仓库）----
logs/

# ---- 本地服务数据 ----
aetherlearn-ai-service/milvus_data/
aetherlearn-ai-service/minio_data/
aetherlearn-ai-service/ollama/

# ---- 系统/临时 ----
.DS_Store
Thumbs.db
*.log
